{
  "name": "lgme",
  "short_name": "lgme",
  "description": "Beta. Peer-to-peer exchange that settles real $lgme from your own Solana wallet.",
  "id": "/exchange",
  "start_url": "/exchange",
  "scope": "/",
  "display": "standalone",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://lgme.app/manifest.webmanifest"
    }
  ],
  "background_color": "#f4f3ef",
  "theme_color": "#F97316",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
