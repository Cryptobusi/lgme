{
  "crons": [
    { "path": "/api/hedera/cron", "schedule": "0 4 * * *" }
  ],
  "cleanUrls": true,
  "redirects": [
    { "source": "/p2p-exchange-sim", "destination": "/exchange", "statusCode": 301 },
    { "source": "/p2p-exchange-sim.html", "destination": "/exchange", "statusCode": 301 },
    { "source": "/mutual-credit-simulator", "destination": "/mutual-credit", "statusCode": 301 },
    { "source": "/mutual-credit-simulator.html", "destination": "/mutual-credit", "statusCode": 301 },
    { "source": "/simulation-explainer", "destination": "/how-it-works", "statusCode": 301 },
    { "source": "/simulation-explainer.html", "destination": "/how-it-works", "statusCode": 301 },
    { "source": "/ididit", "destination": "/exchange", "statusCode": 301 },
    { "source": "/ididit.html", "destination": "/exchange", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/gym-manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/sw-gym.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://api.mainnet-beta.solana.com https://api.devnet.solana.com https://api.geckoterminal.com https://api.dexscreener.com https://huggingface.co https://cdn-lfs.huggingface.co https://raw.githubusercontent.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), payment=(), on-device-speech-recognition=(self)"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
